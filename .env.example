# Copy to .env and fill in. Never commit .env.

# OpenRouter — used for every LLM call in the loop.
OPENROUTER_API_KEY=

# TypeSafe JEV (system-one) — decides how many hypotheses to generate.
JEV_API_KEY=

# Optional: directory where generated hypothesis code is written.
# Defaults to src/agents/enterprise/temporaryCode.
FALEN_CODE_DIR=

# Optional: session id attached to tracker records.
FALEN_SESSION_ID=local

# Optional: ops tracking. Unset falls back to sessions/tracker.sqlite.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
FALEN_TRACKER_DB=
